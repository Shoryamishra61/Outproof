{
  "$defs": {
    "CheckCode": {
      "enum": [
        "BUDGET",
        "CURRENCY",
        "DURATION",
        "ROUTING",
        "RETURN_TRIP",
        "OPENING_HOURS",
        "WALKING",
        "EXCLUSIONS",
        "DIETARY",
        "GROUNDING",
        "PRICE_CONFIDENCE"
      ],
      "title": "CheckCode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "#/$defs/CheckCode"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "hard": {
      "title": "Hard",
      "type": "boolean"
    },
    "message": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Message",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "code",
    "status",
    "hard",
    "message",
    "evidence_ids"
  ],
  "title": "ValidationCheck",
  "type": "object"
}
