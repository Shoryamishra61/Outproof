{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "field": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Field",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "enum": [
            "OSM",
            "VALHALLA",
            "SERPAPI",
            "DIRECT",
            "COMMUNITY",
            "FIXTURE"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Subject Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "evidence_id",
        "subject_id",
        "field",
        "value",
        "source",
        "source_ref",
        "observed_at",
        "expires_at",
        "confidence"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closes_at": {
      "format": "date-time",
      "title": "Closes At",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "opens_at": {
      "format": "date-time",
      "title": "Opens At",
      "type": "string"
    }
  },
  "required": [
    "opens_at",
    "closes_at",
    "evidence"
  ],
  "title": "OpeningWindow",
  "type": "object"
}
